{
    "schemaVersion":  1,
    "repository":  "stephenh678/TrayTrigger-Scripts",
    "scripts":  [
                    {
                        "id":  "afterburner-profile",
                        "name":  "Set Afterburner Profile",
                        "description":  "Switches MSI Afterburner to one of its five profiles for a game, and to another one after it.",
                        "author":  "stephenh678",
                        "version":  "1.0",
                        "phase":  "both",
                        "needsAdmin":  true,
                        "needsAdminReason":  "MSI Afterburner runs as Administrator and only accepts its -Profile switch from a process that does too; without elevation Windows shows a permission prompt for each switch.",
                        "scriptArguments":  "the profile number for the game (1 to 5), optionally the number to switch to after it (\"3 1\"); a path ending in MSIAfterburner.exe overrides where it\u0027s looked for",
                        "dependencies":  "MSI Afterburner",
                        "minAppVersion":  "1.4.0",
                        "source":  "scripts/afterburner-profile",
                        "files":  [
                                      {
                                          "path":  "Set-AfterburnerProfile.ps1",
                                          "sha256":  "982756eb95a711c3c8744d16a9d1b871cb9687d80ef51496382eb3569fb9bc77",
                                          "size":  5287
                                      }
                                  ]
                    },
                    {
                        "id":  "close-background-apps",
                        "name":  "Close Background Apps",
                        "description":  "Closes background apps, such as cloud sync, before a game and reopens them after. Ships with TrayTrigger.",
                        "author":  "stephenh678",
                        "version":  "3.1",
                        "phase":  "both",
                        "needsAdmin":  false,
                        "needsAdminReason":  null,
                        "scriptArguments":  "\"recommended\" for the recommended list (OneDrive, Dropbox, Google Drive), and/or process names to close, separated by spaces, and \"force\" to end any that don\u0027t close when asked; empty does nothing",
                        "dependencies":  "",
                        "minAppVersion":  "1.4.0",
                        "source":  "scripts/close-background-apps",
                        "files":  [
                                      {
                                          "path":  "Example-CloseBackgroundApps.ps1",
                                          "sha256":  "169ed0dd056e3348d172dd14e7fa55e550e632b04bce444065a88b7bb43990d0",
                                          "size":  14062
                                      }
                                  ]
                    },
                    {
                        "id":  "companion-apps",
                        "name":  "Start Companion Apps",
                        "description":  "Starts the tools a game needs when it launches and closes them when it exits. Ships with TrayTrigger.",
                        "author":  "stephenh678",
                        "version":  "2.1",
                        "phase":  "both",
                        "needsAdmin":  false,
                        "needsAdminReason":  null,
                        "scriptArguments":  "full paths of the programs to start, each in double quotes, and \"force\" to end any that don\u0027t close when asked",
                        "dependencies":  "the programs you list",
                        "minAppVersion":  "1.4.0",
                        "source":  "scripts/companion-apps",
                        "files":  [
                                      {
                                          "path":  "Example-StartCompanionApps.ps1",
                                          "sha256":  "19f2a5b3136715e5e1fc4a66af4f8b6afb9d0d20d1cb30dfee80e345b0d0635a",
                                          "size":  12223
                                      }
                                  ]
                    },
                    {
                        "id":  "log-playtime",
                        "name":  "Log Playtime",
                        "description":  "Appends one line per session to a CSV file: when you played, which game, and for how long.",
                        "author":  "stephenh678",
                        "version":  "1.0",
                        "phase":  "postexit",
                        "needsAdmin":  false,
                        "needsAdminReason":  null,
                        "scriptArguments":  "optionally the full path of the CSV file in double quotes; Documents\\TrayTrigger Playtime.csv by default",
                        "dependencies":  "",
                        "minAppVersion":  "1.4.0",
                        "source":  "scripts/log-playtime",
