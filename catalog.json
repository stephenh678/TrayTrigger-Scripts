                    },
                    {
                        "id":  "obs-replay-buffer",
                        "name":  "OBS Replay Buffer",
                        "description":  "Runs OBS in the tray with the replay buffer on while you play, or recording, then closes it so a recording is saved.",
                        "author":  "stephenh678",
                        "version":  "1.1",
                        "phase":  "both",
                        "needsAdmin":  false,
                        "needsAdminReason":  null,
                        "scriptArguments":  "\"record\" to record instead of running the replay buffer, and optionally an OBS profile name in double quotes",
                        "dependencies":  "OBS Studio 30 or newer, with the replay buffer set up",
                        "minAppVersion":  "1.4.0",
                        "source":  "scripts/obs-replay-buffer",
                        "files":  [
